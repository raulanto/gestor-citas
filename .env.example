# Django Settings
SECRET_KEY=django-insecure-change-me-in-production-random-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (PostgreSQL)
DB_NAME=agenda_db
DB_USER=postgres
