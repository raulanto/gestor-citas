# Business Rules / Domain Settings
BOOKING_MIN_ADVANCE_HOURS=2
BOOKING_MAX_ADVANCE_DAYS=60
CANCEL_MIN_HOURS=4
MAX_RESCHEDULES_PER_APPOINTMENT=2
MAX_ACTIVE_PER_REQUESTER_PER_DAY=1
WAITLIST_MAX_PER_DAY=20
DEFAULT_SLOT_STEP_MINUTES=15
WAITLIST_SWEEP_MINUTES=5

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

